# ─ local development (zero setup — SQLite) ─────────────────────────────
# Copy this file to .env for local development.
DATABASE_URL="file:./db/dev.db"

# Admin CMS password — the login for yoursite.com/#/admin
# If unset, the built-in default is "LENOVO@12samsung".
# ⚠️ Override this with your own value before deploying publicly.
ADMIN_PASSWORD="LENOVO@12samsung"

# ─ production (Vercel + Supabase) ──────────────────────────────────────
# Do NOT put the values below in your local .env — set them in
# Vercel → Project → Settings → Environment Variables instead:
#
# 1. Create a project at https://supabase.com (free tier works)
# 2. Open SQL Editor → New query → paste the contents of db/supabase-setup.sql → Run
# 3. Grab the connection string:
#    Supabase → Project Settings → Database → Connection string → "Transaction pooler"
#    (port 6543 — best for serverless). Recommended:
#    postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#    The session pooler (port 5432) also works — the app automatically caps each
#    serverless instance to 1 connection so you stay under Supabase's 15-client
#    session limit.
# 4. In Vercel set:
#    DATABASE_URL = <that connection string>
#    ADMIN_PASSWORD = LENOVO@12samsung   (or your own — this is the login for /#/admin)
#
# The app auto-detects the protocol: postgres:// uses the PostgreSQL client,
# file:// uses the local SQLite client. Nothing else to configure.
